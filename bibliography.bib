@article{callaghanFieldDependenceVortex2005,
  title = {Field {{Dependence}} of the {{Vortex Core Size}} in a {{Multiband Superconductor}}},
  author = {Callaghan, F. D. and Laulajainen, M. and Kaiser, C. V. and Sonier, J. E.},
  date = {2005-11-01},
  journaltitle = {Physical Review Letters},

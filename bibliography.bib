@article{thielQuantitativeNanoscaleVorteximaging2016,
  title = {Quantitative Nanoscale Vortex-Imaging Using a Cryogenic Quantum Magnetometer},
  author = {Thiel, Lucas and Rohner, Dominik and Ganzhorn, Marc and Appel, Patrick and Neu, Elke and M üller, Benedikt and Kleiner, Reinhold and Koelle, Dieter and Maletinsky, Patrick},
  date = {2016-08},
  journaltitle = {Nature Nanotechnology},

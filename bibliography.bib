@article{iguchiSuperconductingVorticesCarrying2023,
  title = {Superconducting Vortices Carrying a Temperature-Dependent Fraction of the Flux Quantum},
  author = {Iguchi, Yusuke and Shi, Ruby A. and Kihou, Kunihiro and Lee, Chul-Ho and Barkman, Mats and Benfenati, Andrea L. and Grinenko, Vadim and Babaev, Egor and Moler, Kathryn A.},

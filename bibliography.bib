@article{baynTriangularNanobeamPhotonic2011,
  title = {Triangular Nanobeam Photonic Cavities in Single-Crystal Diamond},
  author = {Bayn, Igal and Meyler, Boris and Salzman, Joseph and Kalish, Rafi},
  date = {2011-02},
  journaltitle = {New Journal of Physics},
  shortjournal = {New J. Phys.},
